# ─── Signalify environment configuration ─────────────────────────────────────
# Copy to .env and fill in. NEVER commit real secrets.

# ── Robinhood Chain network (testnet by default) ─────────────────────────────
# Robinhood Chain testnet: chain id 46630 | mainnet: chain id 4663
RPC_URL=https://testnet-rpc.robinhoodchain.com
CHAIN_ID=46630
EXPLORER_URL=https://testnet-explorer.robinhoodchain.com
CHAIN_NAME=Robinhood Chain Testnet

# Browser-visible copies of the same values (safe, public)
VITE_RPC_URL=https://testnet-rpc.robinhoodchain.com
VITE_CHAIN_ID=46630
VITE_EXPLORER_URL=https://testnet-explorer.robinhoodchain.com
VITE_CHAIN_NAME=Robinhood Chain Testnet

# ── SGN platform token (ERC-20 on Robinhood Chain) ──────────────────────────
SGN_TOKEN_ADDRESS=
VITE_SGN_TOKEN_ADDRESS=
# USD reference price used for the $5 eligibility check when no price oracle is set
SGN_PRICE_USD=
# Minimum USD value of SGN a wallet must HOLD (never staked/locked) to predict
SGN_MIN_USD=5

# ── Prediction contract (ported from the HyperWave mechanism) ───────────────
PREDICTION_CONTRACT_ADDRESS=
VITE_PREDICTION_CONTRACT_ADDRESS=

# ── Backend signer (server-side ONLY — never exposed to the frontend) ───────
BACKEND_SIGNER_PRIVATE_KEY=

# ── Authoritative price resolution ──────────────────────────────────────────
# Oracle adapter: "chainlink" (Data Streams / stock feeds) or "deterministic"
ORACLE_ADAPTER=deterministic
ORACLE_ADDRESS=
# JSON map of symbol -> feed id / aggregator address, e.g.
# {"AAPL":"0x...","TSLA":"0x..."}
ORACLE_CONFIG=
# Optional REST quote source for stock tokens
STOCK_PRICE_API_URL=
STOCK_PRICE_API_KEY=

# ── Round engine ────────────────────────────────────────────────────────────
ROUND_DURATION_SECONDS=60
BETTING_CUTOFF_SECONDS=10
# Shared secret for the cron endpoint that settles rounds
ROUND_ENGINE_SECRET=

# ── Database (managed by Lovable Cloud; set for local tooling only) ─────────
DATABASE_URL=
